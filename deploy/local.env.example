# Local-only example. Copy values into data/local via the launcher; do not commit real secrets.
AIPEDIA_ENV=local
AIPEDIA_SECRET_KEY=generate-a-local-key-do-not-reuse-production
AIPEDIA_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
AIPEDIA_DB=data/local/aipedia.sqlite3
AIPEDIA_PUBLIC_ORIGIN=https://aipediya.com
# Leave unset in Local: AIPEDIA_TRUST_PROXY, AIPEDIA_INDEXNOW_KEY, advertising, verification tokens.

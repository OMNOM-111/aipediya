AIPEDIA_ENV=production
AIPEDIA_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
AIPEDIA_ALLOWED_HOSTS=aipedia.example.invalid,127.0.0.1,localhost
AIPEDIA_TRUSTED_ORIGINS=https://aipedia.example.invalid
AIPEDIA_DB=/srv/aipedia/data/aipedia.sqlite3
AIPEDIA_TRUST_PROXY=1
AIPEDIA_PUBLIC_ORIGIN=https://aipediya.com
# Paste only verification values from the owner accounts, not the full meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Keep advertising disabled until an approved advertising account and legal contact exist.
AIPEDIA_ADS_ENABLED=0
AIPEDIA_ADS_CLIENT=
AIPEDIA_ADS_SLOT=
AIPEDIA_ADS_TXT=
# Generate this only when IndexNow is ready; the key is served at /indexnow/<key>.txt.
AIPEDIA_INDEXNOW_KEY=
AIPEDIA_PRIVACY_CONTACT=

# AIpedia environment variables — SAFE TEMPLATE. Never commit real secrets.
#
# The application reads configuration from the process environment (os.environ).
# On Local, settings.py also auto-loads an untracked ".env.local" next to
# manage.py (a real environment value always wins over it); the Local launcher
# (tools/local/start-local.ps1) sets the core AIPEDIA_* vars. On Production the
# supervisor env file (deploy/aipedia.env.example) supplies these.
#
# .gitignore keeps ".env" and ".env.*" out of Git (this ".env.example" is the
# only tracked template); a real key must never be committed, logged, or placed
# in AI_CONTEXT.

# --- Azure Translator (optional; dynamic-catalog translation pipeline) ---
# Secret: paste the resource key here ONLY in your own private, untracked copy
# (.env.local), or export it in your shell. Leave EMPTY in this tracked template.
AIPEDIA_AZURE_TRANSLATOR_KEY=

# Non-secret configuration (safe defaults are already baked into settings.py):
AIPEDIA_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AIPEDIA_AZURE_TRANSLATOR_REGION=eastus2

# Provider selector: "mock" (offline default), "azure", or "null".
AIPEDIA_TRANSLATION_PROVIDER=mock

# Standard auto-translation path: when "true", a new or changed model/tool is
# localized automatically right after it is saved (interactive edits). Bulk
# imports suppress this and run one batched translate_catalog pass instead.
# Keep this off unless a working provider is configured.
AIPEDIA_AUTO_TRANSLATE=false
